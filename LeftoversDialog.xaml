<Window x:Class="Kahya.LeftoversDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Kahya.Core"
        Title="Geride kalanlar" Width="720" Height="500" MinWidth="500" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Kaldırıcının silmediği klasörler ve kayıt defteri anahtarları. Klasörler Geri Dönüşüm Kutusu'na gider; anahtarlar silinmeden önce yedeklenir. AppData'dakiler programın ayarları olabilir, seçili gelmez."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <ItemsControl x:Name="EntryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Row}" CornerRadius="9" Padding="12,8" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="box" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"
                                          Click="Changed" ToolTipService.ShowOnDisabled="True"/>
                                <TextBlock Grid.Column="1" Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="16"
                                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                    <TextBlock Text="{Binding Details}" Foreground="{DynamicResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button x:Name="open" Grid.Column="3" Content="&#xE838;" Style="{StaticResource IconBtn}" ToolTip="{c:Tr 'Klasörü aç'}"
                                        VerticalAlignment="Center" Margin="10,0,0,0" Click="Open_Click"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsRegistry}" Value="True">
                                <Setter TargetName="open" Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Locked}" Value="True">
                                <Setter TargetName="box" Property="IsEnabled" Value="False"/>
                                <Setter TargetName="box" Property="ToolTip" Value="{x:Static c:Elevation.LockedTip}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Vazgeç" Style="{StaticResource GhostBtn}" IsCancel="True"/>
            <TextBlock x:Name="InfoText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="12,0,0,0"/>
            <Button x:Name="RemoveBtn" DockPanel.Dock="Right" Content="Seçilenleri sil" Style="{StaticResource AccentBtn}" Margin="0" Click="Remove_Click"/>
        </DockPanel>
    </Grid>
</Window>
