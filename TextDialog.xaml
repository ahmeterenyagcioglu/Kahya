<Window x:Class="Kahya.TextDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayrıntı" Width="760" Height="500" MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Card}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="TitleText" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="SummaryText" Foreground="{DynamicResource Bad}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Bg}" CornerRadius="10" Padding="12,10">
            <TextBox x:Name="BodyText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     BorderThickness="0" Background="Transparent" Foreground="{DynamicResource LogText}"
                     FontFamily="Cascadia Mono, Consolas" FontSize="11.5"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Kopyala" Style="{StaticResource Btn}" Click="Copy_Click"/>
            <Button Content="Tamam" Style="{StaticResource AccentBtn}" Margin="0" IsCancel="True" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
