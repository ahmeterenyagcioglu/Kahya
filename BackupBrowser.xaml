<Window x:Class="Kahya.BackupBrowser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yedeğe göz at" Width="820" Height="600" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Card}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="TitleText" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="InfoText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Bir dosyayı ya da klasörü seçip istediğin yere çıkar. Yedek değişmez; var olan dosyaların üzerine yazılmaz."/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="UpBtn" DockPanel.Dock="Left" Content="&#xE74A;" FontFamily="{StaticResource Icons}" Style="{StaticResource Btn}"
                    ToolTip="Üst klasör" Click="Up_Click"/>
            <Grid DockPanel.Dock="Right" Width="240" Margin="10,0,0,0">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Background="{DynamicResource Bg}" TextChanged="Search_TextChanged"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Muted}"
                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0"/>
                <TextBlock x:Name="SearchHint" Text="Bütün yedekte ara…" Foreground="{DynamicResource Faint}" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="32,0,0,0"/>
            </Grid>
            <TextBlock x:Name="PathText" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Border Grid.Row="2" Background="{DynamicResource Bg}" CornerRadius="10" Padding="4">
            <Grid>
                <ListBox x:Name="List" SelectionMode="Extended" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown" SelectionChanged="List_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" CornerRadius="6" Padding="10,6" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Control}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Foreground="{DynamicResource Muted}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{DynamicResource AccentText}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Location}" Foreground="{DynamicResource Muted}" FontSize="11.5"
                                               TextTrimming="CharacterEllipsis" Visibility="{Binding LocationVisibility}"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Kapat" Style="{StaticResource Btn}" IsCancel="True" Click="Close_Click"/>
                <Button x:Name="ExtractBtn" Content="Seçilenleri çıkar…" Style="{StaticResource AccentBtn}" Margin="0" IsEnabled="False"
                        Click="Extract_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
