<Window x:Class="Kahya.MaintenanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tek tıkla bakım" Width="660" SizeToContent="Height" MaxHeight="900" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="Step" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="StepIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="DockPanel.Dock" Value="Left"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Margin" Value="2,14,0,8"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="26,22,26,22">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <TextBlock Text="Tek tıkla bakım" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Seçtiklerin sırayla yapılır; bilgisayarı kullanmaya devam edebilirsin." Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Başlat" Style="{StaticResource AccentBtn}" Margin="0" IsDefault="True" Click="Start_Click"/>
            <Button DockPanel.Dock="Right" Content="Kaydet" Style="{StaticResource Btn}" Click="Save_Click"
                    ToolTip="Başlatmadan kaydet (otomatik bakımı ayarlamak için)"/>
            <Button DockPanel.Dock="Left" Content="Vazgeç" Style="{StaticResource GhostBtn}" IsCancel="True"/>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <TextBlock Text="YAPILACAKLAR" Style="{StaticResource Section}"/>

                <!-- Temizlik -->
                <Border Style="{StaticResource Step}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox x:Name="CleanBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Changed"/>
                            <Button x:Name="CleanExpandBtn" DockPanel.Dock="Right" Content="Kategoriler ▾" Style="{StaticResource GhostBtn}"
                                    Margin="0,0,10,0" VerticalAlignment="Center" Click="CleanExpand_Click"/>
                            <TextBlock Style="{StaticResource StepIcon}" Text="&#xE74D;"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Temizlik" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CleanInfo" Style="{StaticResource Sub}"/>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel x:Name="CleanPanel" Visibility="Collapsed" Margin="32,12,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Önerilenler" Style="{StaticResource SmallBtn}" Click="CleanRecommended_Click"/>
                                <Button Content="Temizlik sekmesindekiler" Style="{StaticResource SmallBtn}" Click="CleanFromTab_Click"/>
                                <Button Content="Hiçbiri" Style="{StaticResource SmallBtn}" Click="CleanNone_Click"/>
                            </StackPanel>
                            <ItemsControl x:Name="CleanList">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" Margin="0,8,0,4"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                        <GroupStyle.Panel>
                                            <ItemsPanelTemplate>
                                                <StackPanel/>
                                            </ItemsPanelTemplate>
                                        </GroupStyle.Panel>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Width="252" Margin="0,3" Click="Changed"
                                                  ToolTip="{Binding Description}">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Step}">
                    <DockPanel>
                        <CheckBox x:Name="UpdatesBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Changed"/>
                        <TextBlock Style="{StaticResource StepIcon}" Text="&#xE895;"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Uygulama güncellemeleri" FontWeight="SemiBold"/>
                            <TextBlock x:Name="UpdatesInfo" Style="{StaticResource Sub}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Step}">
                    <DockPanel>
                        <CheckBox x:Name="DriversBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Changed"/>
                        <TextBlock Style="{StaticResource StepIcon}" Text="&#xE7B8;"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Eski sürücü paketlerini kaldır" FontWeight="SemiBold"/>
                            <TextBlock Text="Daha yenisi kurulu olanlar; kullanımdakilere dokunulmaz" Style="{StaticResource Sub}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Step}">
                    <DockPanel>
                        <CheckBox x:Name="OptimizeBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Changed"/>
                        <TextBlock Style="{StaticResource StepIcon}" Text="&#xEDA2;"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Sürücüleri optimize et" FontWeight="SemiBold"/>
                            <TextBlock Text="SSD'ye TRIM, HDD'ye birleştirme" Style="{StaticResource Sub}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="SEÇENEKLER" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource Step}">
                    <StackPanel>
                        <CheckBox x:Name="RestorePointBox" Margin="0,0,0,10"
                                  ToolTip="Bir güncelleme sorun çıkarırsa Sistem Geri Yükleme ile bu ana dönebilirsin.">
                            <TextBlock Text="Güncellemeden önce geri yükleme noktası oluştur"/>
                        </CheckBox>
                        <CheckBox x:Name="ShutdownBox" ToolTip="Sadece bu sefer için; otomatik bakımda kullanılmaz.">
                            <TextBlock Text="Bitince bilgisayarı kapat"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <TextBlock Text="OTOMATİK ÇALIŞTIR" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource Step}">
                    <StackPanel>
                        <Border Style="{StaticResource SegBar}" Background="{DynamicResource Row}">
                            <StackPanel x:Name="ModePanel" Orientation="Horizontal">
                                <Button Content="Kapalı" Style="{StaticResource Seg}" Tag="off" Click="Mode_Click"/>
                                <Button Content="Her gün" Style="{StaticResource Seg}" Tag="daily" Click="Mode_Click"/>
                                <Button Content="Her hafta" Style="{StaticResource Seg}" Tag="weekly" Click="Mode_Click"/>
                                <Button Content="2 haftada bir" Style="{StaticResource Seg}" Tag="biweekly" Click="Mode_Click"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="WhenPanel" Margin="0,10,0,0">
                            <Border x:Name="DayBar" Style="{StaticResource SegBar}" Background="{DynamicResource Row}" Margin="0,0,0,8">
                                <StackPanel x:Name="DayPanel" Orientation="Horizontal">
                                    <Button Content="Pzt" Style="{StaticResource Seg}" Tag="Monday" Click="Day_Click"/>
                                    <Button Content="Sal" Style="{StaticResource Seg}" Tag="Tuesday" Click="Day_Click"/>
                                    <Button Content="Çar" Style="{StaticResource Seg}" Tag="Wednesday" Click="Day_Click"/>
                                    <Button Content="Per" Style="{StaticResource Seg}" Tag="Thursday" Click="Day_Click"/>
                                    <Button Content="Cum" Style="{StaticResource Seg}" Tag="Friday" Click="Day_Click"/>
                                    <Button Content="Cmt" Style="{StaticResource Seg}" Tag="Saturday" Click="Day_Click"/>
                                    <Button Content="Paz" Style="{StaticResource Seg}" Tag="Sunday" Click="Day_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SegBar}" Background="{DynamicResource Row}">
                                <StackPanel x:Name="HourPanel" Orientation="Horizontal">
                                    <Button Content="09:00" Style="{StaticResource Seg}" Tag="9" Click="Hour_Click"/>
                                    <Button Content="12:00" Style="{StaticResource Seg}" Tag="12" Click="Hour_Click"/>
                                    <Button Content="15:00" Style="{StaticResource Seg}" Tag="15" Click="Hour_Click"/>
                                    <Button Content="18:00" Style="{StaticResource Seg}" Tag="18" Click="Hour_Click"/>
                                    <Button Content="21:00" Style="{StaticResource Seg}" Tag="21" Click="Hour_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="ScheduleInfo" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
