<Window x:Class="Kahya.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Kahya.Core"
        Title="Kahya" Icon="/app.ico" Width="1180" Height="800" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- Sekme başlıkları gizli; gezinme soldaki menüden -->
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sekme içeriği metin rengini TabItem'dan alır; varsayılanı siyah -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>

        <Style x:Key="NavList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,1">
                            <Border x:Name="bg" CornerRadius="8" Background="Transparent"/>
                            <Border x:Name="bar" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                    Background="{StaticResource AccentGradient}" Visibility="Collapsed"/>
                            <ContentPresenter Margin="14,9,10,9"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource NavHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource NavSelected}"/>
                                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="{DynamicResource BarTrack}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Row}"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StaticRow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Row}"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="RowSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>

        <Style x:Key="RowIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <Style x:Key="EmptyIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="Foreground" Value="{DynamicResource EmptyGlyph}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="EmptyText" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="MaxWidth" Value="460"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Araçlar sekmesindeki "çalıştır" satırları -->
        <Style x:Key="ActionRow" TargetType="Border" BasedOn="{StaticResource StaticRow}">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <!-- Genel bakış kutucukları -->
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,15"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Başlangıç: uygulamalar / görevler / servisler satırı -->
        <DataTemplate x:Key="BackgroundRow">
            <Border Style="{StaticResource StaticRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="26" Height="26" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7C4;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource Faint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding Icon}" Width="26" Height="26"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}"/>
                        <TextBlock Style="{StaticResource RowSub}" ToolTip="{Binding Tooltip}">
                            <Run Text="{Binding Publisher, Mode=OneWay}"/>
                            <Run Text="  ·  " Foreground="{DynamicResource Faint}"/>
                            <Run Text="{Binding Details, Mode=OneWay}" Foreground="{DynamicResource Faint}"/>
                        </TextBlock>
                    </StackPanel>
                    <CheckBox x:Name="sw" Grid.Column="2" Style="{StaticResource Switch}" Margin="14,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}" ToolTipService.ShowOnDisabled="True"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Locked}" Value="True">
                    <Setter TargetName="sw" Property="IsEnabled" Value="False"/>
                    <Setter TargetName="sw" Property="ToolTip" Value="{x:Static c:Elevation.LockedTip}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═════════════ Sol menü ═════════════ -->
        <Border Background="{DynamicResource Side}">
            <DockPanel Margin="14,18,14,16">
                <DockPanel DockPanel.Dock="Top" Margin="8,0,0,26">
                    <Button x:Name="ThemeToggleBtn" DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Click="ThemeToggle_Click"
                            VerticalAlignment="Center"/>
                    <Image x:Name="SideIcon" Width="30" Height="30" Margin="0,0,10,0"/>
                    <TextBlock Text="Kahya" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="MaintenanceBtn" Style="{StaticResource AccentBtn}" Margin="0" Padding="14,11"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Maintenance_Click" c:Elevation.Required="True"
                            ToolTip="Temizlik, güncellemeler ve diğer bakım adımları art arda. Neyin yapılacağını sen seçersin.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Tek tıkla bakım" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="ScheduleText" Style="{StaticResource Hint}" FontSize="11.5" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <ListBox x:Name="Nav" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavItem}"
                         SelectedIndex="{Binding SelectedIndex, ElementName=Tabs, Mode=TwoWay}">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE80F;"/>
                            <TextBlock Style="{StaticResource NavText}" Text="Genel bakış"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE74D;"/>
                            <TextBlock Style="{StaticResource NavText}" Text="Temizlik"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE895;"/>
                            <TextBlock Style="{StaticResource NavText}" Text="Güncellemeler"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE71D;"/>
                            <TextBlock Style="{StaticResource NavText}" Text="Uygulamalar"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE7E8;"/>
                            <TextBlock Style="{StaticResource NavText}" Text="Başlangıç"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xEA18;"/>
                            <TextBlock Style="{StaticResource NavText}" Text="Gizlilik"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xEB05;"/>
                            <TextBlock Style="{StaticResource NavText}" Text="Disk analizi"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE90F;"/>
                            <TextBlock Style="{StaticResource NavText}" Text="Araçlar"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE78C;"/>
                            <TextBlock Style="{StaticResource NavText}" Text="Format yardımcısı"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE946;"/>
                            <TextBlock Style="{StaticResource NavText}" Text="Hakkında"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ═════════════ İçerik ═════════════ -->
        <Grid Grid.Column="1" Margin="30,22,28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Sayfa başlığı -->
            <DockPanel Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="150">
                    <!-- Gösterilecek bir sayı yoksa ("—") hiç görünmesin -->
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TotalText}" Value="—">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock x:Name="TotalText" Text="—" FontFamily="{StaticResource Display}" FontSize="28" FontWeight="SemiBold"
                               Foreground="{DynamicResource Good}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TotalCaption" Text="" Foreground="{DynamicResource Muted}" FontSize="12" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" FontFamily="{StaticResource Display}" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageSubtitle" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>

            <!-- Uyarı şeritleri -->
            <StackPanel Grid.Row="1">
                <Border x:Name="AdminBanner" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="10"
                        Padding="14,8" Margin="0,0,0,12" Visibility="Collapsed">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Gizle" Style="{StaticResource GhostBtn}" Margin="6,0,0,0" Click="AdminBannerClose_Click"/>
                        <Button DockPanel.Dock="Right" Content="Yönetici olarak yeniden başlat" Style="{StaticResource SmallBtn}" Margin="0"
                                Click="AdminRestart_Click"/>
                        <TextBlock DockPanel.Dock="Left" Text="&#xEA18;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{DynamicResource Warn}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Yönetici olarak çalışmıyor. Kalkan işaretli özellikler (Windows klasörleri, onarım araçları, bakım) kapalı."/>
                    </DockPanel>
                </Border>
                <Border x:Name="GpuBanner" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="10"
                        Padding="14,8" Margin="0,0,0,12" Visibility="Collapsed">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Gizle" Style="{StaticResource GhostBtn}" Margin="6,0,0,0" Click="GpuBannerClose_Click"/>
                        <Button DockPanel.Dock="Right" Content="Sürücü sayfası" Style="{StaticResource SmallBtn}" Margin="0" Click="GpuBannerOpen_Click"/>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{DynamicResource Warn}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="GpuBannerText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <Border x:Name="UpdateBanner" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" CornerRadius="10"
                        Padding="14,8" Margin="0,0,0,12" Visibility="Collapsed">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Sürüm notları" Style="{StaticResource GhostBtn}" Margin="6,0,0,0" Click="UpdateBannerOpen_Click"/>
                        <Button x:Name="SelfUpdateBtn" DockPanel.Dock="Right" Content="Güncelle" Style="{StaticResource SmallBtn}" Margin="0" Click="SelfUpdate_Click"/>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{DynamicResource AccentText}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <TabControl x:Name="Tabs" Grid.Row="2" SelectionChanged="Tabs_SelectionChanged">

                <!-- ═════════════ Genel bakış ═════════════ -->
                <TabItem x:Name="OverviewTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <Border Style="{StaticResource ToolCard}" Padding="22,18">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Btn}" Click="Report_Click"
                                                ToolTip="Bilgisayarın durumunu tek sayfalık bir rapor olarak kaydet (tarayıcıda açılır, PDF'e çevrilebilir). Yardım isterken göndermek için.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE9F9;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Rapor"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Btn}" Click="OverviewRefresh_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Yenile"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource AccentBtn}" Margin="0" Click="Maintenance_Click" c:Elevation.Required="True">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Tek tıkla bakım"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock x:Name="OverviewIcon" DockPanel.Dock="Left" FontFamily="{StaticResource Icons}" FontSize="34"
                                               VerticalAlignment="Center" Margin="0,0,18,0" Foreground="{DynamicResource Muted}" Text="&#xE9F5;"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="OverviewTitle" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold" Text="Kontrol ediliyor…"/>
                                        <TextBlock x:Name="OverviewSub" Style="{StaticResource Hint}" FontSize="12.5" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <ItemsControl x:Name="TileList" Margin="0,0,-12,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Tile}" MouseLeftButtonUp="Tile_Click" ToolTip="{Binding Tooltip}">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock x:Name="ic" Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="15"
                                                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                                    <TextBlock Text="&#xE76C;" DockPanel.Dock="Right" FontFamily="{StaticResource Icons}" FontSize="10"
                                                               Foreground="{DynamicResource Faint}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Muted}" FontSize="12.5" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <TextBlock x:Name="val" Text="{Binding Value}" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="good">
                                                <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource Good}"/>
                                                <Setter TargetName="val" Property="Foreground" Value="{DynamicResource Good}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="warn">
                                                <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource Warn}"/>
                                                <Setter TargetName="val" Property="Foreground" Value="{DynamicResource Warn}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="bad">
                                                <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource Bad}"/>
                                                <Setter TargetName="val" Property="Foreground" Value="{DynamicResource Bad}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="wait">
                                                <Setter TargetName="val" Property="Foreground" Value="{DynamicResource Faint}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═════════════ Temizlik ═════════════ -->
                <TabItem x:Name="CleanTab">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Temizle" Style="{StaticResource AccentBtn}" Click="Clean_Click" Margin="0"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="Analyze_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Yeniden tara"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Önerilenler" Style="{StaticResource SmallBtn}" Click="Recommended_Click"/>
                                <Button Content="Tümü" Style="{StaticResource SmallBtn}" Click="All_Click"
                                        ToolTip="Çerez ve geçmiş gibi kişisel veriler hariç"/>
                                <Button Content="Hiçbiri" Style="{StaticResource SmallBtn}" Click="None_Click"/>
                                <Button x:Name="ExpandAllBtn" Content="Hepsini aç" Style="{StaticResource GhostBtn}" Click="ExpandAll_Click" Margin="6,0,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="1" Style="{StaticResource ListCard}" Padding="6,6,2,6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                <ItemsControl x:Name="List">
                                    <ItemsControl.Resources>
                                        <DataTemplate x:Key="CleanItemTemplate">
                                            <Border x:Name="row" Style="{StaticResource RowBorder}" MouseLeftButtonUp="Row_MouseLeftButtonUp">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="36"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox x:Name="cb" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}"/>
                                                            <TextBlock x:Name="lock" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0,0,0"
                                                                       Foreground="{DynamicResource Warn}" FontSize="11">
                                                                <Run Text="&#xEA18;" FontFamily="{StaticResource Icons}"/>
                                                                <Run Text="{c:Tr 'yönetici gerekli'}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource RowSub}" ToolTip="{Binding Description}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="100" Margin="14,0,0,0">
                                                        <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="3" Content="&#xE721;" Style="{StaticResource IconBtn}" HorizontalAlignment="Right"
                                                            VerticalAlignment="Center" Click="Preview_Click"
                                                            Visibility="{Binding HasPreview, Converter={StaticResource BoolVis}}"
                                                            ToolTip="{c:Tr 'Önizle: hangi klasörden ne kadar silinecek'}"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Locked}" Value="True">
                                                    <Setter TargetName="cb" Property="IsEnabled" Value="False"/>
                                                    <Setter TargetName="row" Property="Opacity" Value="0.6"/>
                                                    <Setter TargetName="row" Property="Cursor" Value="Arrow"/>
                                                    <Setter TargetName="lock" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="row" Property="ToolTip" Value="{x:Static c:Elevation.LockedTip}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.Resources>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel x:Name="grp">
                                                <Border x:Name="head" Background="Transparent" CornerRadius="9" Padding="10,10,12,10" Cursor="Hand"
                                                        MouseLeftButtonUp="GroupHeader_MouseLeftButtonUp">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="chev" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="10" Width="16"
                                                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                                                                  VerticalAlignment="Center" Margin="6,0,14,0"
                                                                  ToolTip="{c:Tr 'Gruptaki her şeyi seç ya da kaldır (kişisel veriler hariç)'}"/>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding SelectionText}" Foreground="{DynamicResource Muted}" FontSize="11.5"
                                                                       VerticalAlignment="Center" Margin="12,1,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ItemsControl x:Name="items" ItemsSource="{Binding VisibleItems}" ItemTemplate="{StaticResource CleanItemTemplate}"
                                                              Margin="20,0,0,10" Visibility="Collapsed"/>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter TargetName="items" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="chev" Property="Text" Value="&#xE70D;"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasVisible}" Value="False">
                                                    <Setter TargetName="grp" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <Trigger SourceName="head" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="head" Property="Background" Value="{DynamicResource RowHover}"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <DockPanel Grid.Row="2" Margin="2,12,0,0">
                            <TextBlock x:Name="HistoryText" DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="SkipRecentBox" VerticalAlignment="Center"
                                          ToolTip="Şu an çalışan kurulumların geçici dosyalarına dokunmamak için.">
                                    <TextBlock Text="Son 24 saatte değişen geçici dosyaları atla" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                </CheckBox>
                                <CheckBox x:Name="HideEmptyBox" VerticalAlignment="Center" Margin="20,0,0,0" Click="HideEmpty_Click"
                                          ToolTip="Taramada hiçbir şey bulunmayan öğeleri listeden gizler. Seçimler değişmez.">
                                    <TextBlock Text="Boş olanları gizle" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                </CheckBox>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- ═════════════ Güncellemeler ═════════════ -->
                <TabItem x:Name="UpdatesTab">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Seçilenleri güncelle" Style="{StaticResource AccentBtn}" Click="Upgrade_Click" Margin="0"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="CheckUpdates_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Kontrol et"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="UpdatesInfo" DockPanel.Dock="Right" Style="{StaticResource Label}" Margin="0,0,12,0"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Tümü" Style="{StaticResource SmallBtn}" Click="PkgAll_Click"/>
                                <Button Content="Hiçbiri" Style="{StaticResource SmallBtn}" Click="PkgNone_Click"/>
                                <CheckBox x:Name="RestorePointBox" VerticalAlignment="Center" Margin="10,0,0,0"
                                          ToolTip="Bir güncelleme sorun çıkarırsa Sistem Geri Yükleme ile bu ana dönebilirsin.">
                                    <TextBlock Text="Önce geri yükleme noktası" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                </CheckBox>
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="1" Style="{StaticResource ListCard}">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                    <ItemsControl x:Name="PackageList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="row" Style="{StaticResource RowBorder}" MouseLeftButtonUp="Row_MouseLeftButtonUp">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="cb" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}"/>
                                                            <TextBlock Text="{Binding Id}" Style="{StaticResource RowSub}"/>
                                                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Bad}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                                                       Visibility="{Binding HasError, Converter={StaticResource BoolVis}}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="160" Margin="14,0,0,0">
                                                            <TextBlock HorizontalAlignment="Right" FontSize="12.5">
                                                                <Run Text="{Binding Version, Mode=OneWay}" Foreground="{DynamicResource Muted}"/>
                                                                <Run Text=" → " Foreground="{DynamicResource Faint}"/>
                                                                <Run Text="{Binding Available, Mode=OneWay}" Foreground="{DynamicResource Good}" FontWeight="SemiBold"/>
                                                            </TextBlock>
                                                            <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Muted}">
                                                                <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                                                <Run Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource Text}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <Button Content="{c:Tr Ayrıntı}" Style="{StaticResource GhostBtn}" Click="UpdateDetails_Click"
                                                                    Visibility="{Binding HasError, Converter={StaticResource BoolVis}}"
                                                                    ToolTip="{c:Tr 'winget çıktısının tamamı'}"/>
                                                            <Button x:Name="skip" Content="{c:Tr Atla}" Style="{StaticResource GhostBtn}" Click="IgnoreUpdate_Click"
                                                                    ToolTip="{c:Tr 'Bu uygulamayı güncelleme: seçili gelmez, bakımda da atlanır'}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                                        <Setter TargetName="row" Property="Opacity" Value="0.55"/>
                                                        <Setter TargetName="skip" Property="Content" Value="{c:Tr 'Atlanıyor'}"/>
                                                        <Setter TargetName="skip" Property="Foreground" Value="{DynamicResource Warn}"/>
                                                        <Setter TargetName="skip" Property="ToolTip" Value="{c:Tr 'Tekrar güncellenmesi için tıkla'}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <StackPanel x:Name="UpdatesEmptyPanel" VerticalAlignment="Center" Margin="20"
                                            Visibility="{Binding Visibility, ElementName=UpdatesEmpty}">
                                    <TextBlock Style="{StaticResource EmptyIcon}" Text="&#xE895;"/>
                                    <TextBlock x:Name="UpdatesEmpty" Style="{StaticResource EmptyText}" Text="Güncellemeleri görmek için 'Kontrol et'e bas."/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="UpdatesSelection" Grid.Row="2" Style="{StaticResource Hint}" Margin="2,12,0,0"/>
                    </Grid>
                </TabItem>

                <!-- ═════════════ Uygulamalar ═════════════ -->
                <TabItem x:Name="AppsTab">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,12">
                            <Grid DockPanel.Dock="Right" Width="260">
                                <TextBox x:Name="AppSearch" Style="{StaticResource SearchBox}" TextChanged="AppSearch_TextChanged"/>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Muted}"
                                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0"/>
                                <TextBlock x:Name="AppSearchHint" Text="Ara…" Foreground="{DynamicResource Faint}" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Margin="33,0,0,0"/>
                            </Grid>
                            <Border Style="{StaticResource SegBar}">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ProgramsModeBtn" Content="Yüklü programlar" Style="{StaticResource Seg}" Click="ProgramsMode_Click"/>
                                    <Button x:Name="BloatModeBtn" Content="Gereksiz Windows uygulamaları" Style="{StaticResource Seg}" Click="BloatMode_Click"/>
                                    <Button x:Name="InstallModeBtn" Content="Program kur" Style="{StaticResource Seg}" Click="InstallMode_Click"
                                            ToolTip="Yeni bilgisayar kurulumu: sık kullanılan programları işaretle, hepsi tek seferde kurulsun"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <Border Grid.Row="1" Style="{StaticResource ListCard}">
                            <Grid>
                                <ScrollViewer x:Name="ProgramsPanel" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                    <ItemsControl x:Name="ProgramList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StaticRow}" Padding="14,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="{Binding Icon}" Width="26" Height="26" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}"/>
                                                            <TextBlock Text="{Binding Details}" Style="{StaticResource RowSub}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   MinWidth="80" TextAlignment="Right" Margin="12,0,14,0"/>
                                                        <Button Grid.Column="3" Content="{c:Tr Kaldır}" Style="{StaticResource SmallBtn}" Margin="0"
                                                                VerticalAlignment="Center" Click="Uninstall_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <ScrollViewer x:Name="BloatPanel" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Visibility="Collapsed">
                                    <ItemsControl x:Name="BloatList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RowBorder}" MouseLeftButtonUp="Row_MouseLeftButtonUp">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}"/>
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource RowSub}" ToolTip="{Binding Description}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11.5"
                                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <ScrollViewer x:Name="InstallPanel" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Visibility="Collapsed">
                                    <ItemsControl x:Name="InstallList">
                                        <ItemsControl.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentText}" Margin="6,14,0,8"/>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ItemsControl.GroupStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="row" Style="{StaticResource RowBorder}" MouseLeftButtonUp="Row_MouseLeftButtonUp">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="cb" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}"/>
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource RowSub}" ToolTip="{Binding Id}"/>
                                                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Bad}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                                                       Visibility="{Binding HasError, Converter={StaticResource BoolVis}}"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="st" Grid.Column="2" Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11.5"
                                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="{c:Tr Ayrıntı}" Style="{StaticResource GhostBtn}" Click="InstallDetails_Click"
                                                                    Margin="6,0,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolVis}}"/>
                                                            <Button x:Name="web" Content="{c:Tr 'Web\'de ara'}" Style="{StaticResource SmallBtn}" Click="InstallSearchWeb_Click"
                                                                    Margin="6,0,0,0" Visibility="Collapsed" ToolTip="{c:Tr 'İndirme sayfasını bulmak için tarayıcıda arar'}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding CanInstall}" Value="False">
                                                        <Setter TargetName="cb" Property="IsEnabled" Value="False"/>
                                                        <Setter TargetName="row" Property="Cursor" Value="Arrow"/>
                                                        <Setter TargetName="web" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                        <Setter TargetName="cb" Property="IsEnabled" Value="False"/>
                                                        <Setter TargetName="row" Property="Opacity" Value="0.6"/>
                                                        <Setter TargetName="row" Property="Cursor" Value="Arrow"/>
                                                        <Setter TargetName="st" Property="Text" Value="{c:Tr 'kurulu ✔'}"/>
                                                        <Setter TargetName="st" Property="Foreground" Value="{DynamicResource Good}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock x:Name="AppsEmpty" Style="{StaticResource EmptyText}" VerticalAlignment="Center" Margin="20" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <DockPanel Grid.Row="2" Margin="2,12,0,0" LastChildFill="False">
                            <TextBlock x:Name="AppsInfo" DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Hint}"/>
                            <Button x:Name="RemoveBloatBtn" DockPanel.Dock="Right" Content="Seçilenleri kaldır" Style="{StaticResource AccentBtn}"
                                    Click="RemoveBloat_Click" Margin="0" Visibility="Collapsed"/>
                            <Button x:Name="InstallBtn" DockPanel.Dock="Right" Content="Seçilenleri kur" Style="{StaticResource AccentBtn}"
                                    Click="Install_Click" Margin="0" Visibility="Collapsed"/>
                            <Button DockPanel.Dock="Right" Content="Yenile" Style="{StaticResource Btn}" Click="AppsRefresh_Click"/>
                            <Button x:Name="ListLoadBtn" DockPanel.Dock="Right" Content="Listeden yükle…" Style="{StaticResource Btn}"
                                    Click="ProgramListLoad_Click" Visibility="Collapsed"
                                    ToolTip="Format öncesi kaydettiğin program listesini aç: winget'te olanlar işaretli gelir, tek seferde kurulur. Olmayanların adı listede durur."/>
                            <Button x:Name="ListSaveBtn" DockPanel.Dock="Right" Content="Listeyi kaydet…" Style="{StaticResource Btn}"
                                    Click="ProgramListSave_Click"
                                    ToolTip="Yüklü programlarının listesini bir metin dosyasına kaydet. Format attıktan sonra 'Program kur › Listeden yükle…' ile winget'te olanları tek seferde kurarsın."/>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- ═════════════ Başlangıç ═════════════ -->
                <TabItem x:Name="StartupTab">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource SegBar}" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="StartupAppsBtn" Content="Uygulamalar" Style="{StaticResource Seg}" Tag="apps" Click="StartupMode_Click"/>
                                <Button x:Name="StartupTasksBtn" Content="Zamanlanmış görevler" Style="{StaticResource Seg}" Tag="tasks" Click="StartupMode_Click"
                                        ToolTip="Programların kendini güncellemek vb. için kurduğu görevler. Microsoft'un görevleri listelenmez."/>
                                <Button x:Name="StartupServicesBtn" Content="Servisler" Style="{StaticResource Seg}" Tag="services" Click="StartupMode_Click"
                                        ToolTip="Programların arka planda sürekli çalışan servisleri. Microsoft'un servisleri listelenmez."/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource ListCard}">
                            <Grid>
                                <ScrollViewer x:Name="StartupAppsPanel" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                    <ItemsControl x:Name="StartupList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StaticRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="{Binding Icon}" Width="26" Height="26" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}"/>
                                                            <TextBlock Style="{StaticResource RowSub}" ToolTip="{Binding Command}">
                                                                <Run Text="{Binding Publisher, Mode=OneWay}"/>
                                                                <Run Text="  ·  " Foreground="{DynamicResource Faint}"/>
                                                                <Run Text="{Binding Details, Mode=OneWay}" Foreground="{DynamicResource Faint}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <CheckBox x:Name="sw" Grid.Column="2" Style="{StaticResource Switch}" Margin="14,0,0,0" VerticalAlignment="Center"
                                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" ToolTipService.ShowOnDisabled="True"/>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Locked}" Value="True">
                                                        <Setter TargetName="sw" Property="IsEnabled" Value="False"/>
                                                        <Setter TargetName="sw" Property="ToolTip" Value="{x:Static c:Elevation.LockedTip}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <ScrollViewer x:Name="StartupTasksPanel" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Visibility="Collapsed">
                                    <ItemsControl x:Name="TaskList" ItemTemplate="{StaticResource BackgroundRow}"/>
                                </ScrollViewer>
                                <ScrollViewer x:Name="StartupServicesPanel" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Visibility="Collapsed">
                                    <ItemsControl x:Name="ServiceList" ItemTemplate="{StaticResource BackgroundRow}"/>
                                </ScrollViewer>
                                <TextBlock x:Name="StartupEmpty" Style="{StaticResource EmptyText}" VerticalAlignment="Center" Margin="20" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <DockPanel Grid.Row="2" Margin="2,12,0,0" LastChildFill="False">
                            <TextBlock x:Name="StartupInfo" DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Hint}"/>
                            <Button DockPanel.Dock="Right" Content="Yenile" Style="{StaticResource Btn}" Click="StartupRefresh_Click" Margin="0"/>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- ═════════════ Gizlilik ═════════════ -->
                <TabItem x:Name="PrivacyTab">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource SegBar}" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PrivacySettingsBtn" Content="Windows ayarları" Style="{StaticResource Seg}" Click="PrivacyMode_Click" Tag="settings"/>
                                <Button x:Name="PrivacyExtBtn" Content="Tarayıcı eklentileri" Style="{StaticResource Seg}" Click="PrivacyMode_Click" Tag="ext"
                                        ToolTip="Chrome, Edge, Brave, Vivaldi ve Opera'daki eklentiler. Sadece listelenir, hiçbir şey değiştirilmez."/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ExtCard" Grid.Row="1" Style="{StaticResource ListCard}" Visibility="Collapsed">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                    <ItemsControl x:Name="ExtList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StaticRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Width="26" Height="26" Margin="0,0,14,0" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xEA86;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource Faint}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image Source="{Binding Icon}" Width="26" Height="26"/>
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}"/>
                                                            <TextBlock Text="{Binding Details}" Style="{StaticResource RowSub}"/>
                                                            <TextBlock x:Name="flags" Text="{Binding FlagText}" Foreground="{DynamicResource Muted}" FontSize="11.5"
                                                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                            <Button x:Name="store" Content="{c:Tr Mağaza}" Style="{StaticResource GhostBtn}" Click="ExtStore_Click"
                                                                    ToolTip="{c:Tr 'Eklentinin mağaza sayfası: yorumlar, yayıncı, son güncelleme'}"/>
                                                            <Button Content="&#xE838;" Style="{StaticResource IconBtn}" Click="ExtFolder_Click" ToolTip="{c:Tr 'Klasörü aç'}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Warning}" Value="True">
                                                        <Setter TargetName="flags" Property="Foreground" Value="{DynamicResource Warn}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding FromStore}" Value="False">
                                                        <Setter TargetName="store" Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock x:Name="ExtEmpty" Style="{StaticResource EmptyText}" VerticalAlignment="Center" Margin="20" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <Border x:Name="PrivacySettingsCard" Grid.Row="1" Style="{StaticResource ListCard}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                <ItemsControl x:Name="PrivacyList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StaticRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock>
                                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                            <Run Text="  "/>
                                                            <Run Text="{Binding Badge, Mode=OneWay}" Foreground="{DynamicResource AccentText}" FontSize="11"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource RowSub}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <CheckBox x:Name="sw" Grid.Column="1" Style="{StaticResource Switch}" Margin="16,0,0,0" VerticalAlignment="Center"
                                                              IsChecked="{Binding IsApplied, Mode=TwoWay}" ToolTipService.ShowOnDisabled="True"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Locked}" Value="True">
                                                    <Setter TargetName="sw" Property="IsEnabled" Value="False"/>
                                                    <Setter TargetName="sw" Property="ToolTip" Value="{x:Static c:Elevation.LockedTip}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <DockPanel x:Name="ExtBar" Grid.Row="2" Margin="2,12,0,0" Visibility="Collapsed">
                            <Button DockPanel.Dock="Right" Content="Yenile" Style="{StaticResource Btn}" Margin="0" Click="ExtRefresh_Click"/>
                            <TextBlock x:Name="ExtInfo" VerticalAlignment="Center" Style="{StaticResource Hint}" Margin="0,0,12,0"/>
                        </DockPanel>

                        <DockPanel x:Name="PrivacyBar" Grid.Row="2" Margin="2,12,0,0" LastChildFill="False">
                            <TextBlock x:Name="PrivacyInfo" DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Hint}"/>
                            <Button DockPanel.Dock="Right" Content="Önerilenleri uygula" Style="{StaticResource AccentBtn}" Margin="0" Click="PrivacyRecommended_Click"/>
                            <Button x:Name="PrivacyUndoBtn" DockPanel.Dock="Right" Content="Değişiklikleri geri al" Style="{StaticResource Btn}" Click="PrivacyUndo_Click"
                                    Visibility="Collapsed"
                                    ToolTip="Bu sekmede değiştirdiğin her ayarı, Kahya'dan önceki haline döndürür (ilk değişiklikte yedeklenmişti)."/>
                            <Button DockPanel.Dock="Right" Content="Gezgin'i yeniden başlat" Style="{StaticResource Btn}" Click="RestartExplorer_Click"
                                    ToolTip="Başlat menüsü ve Gezgin ayarlarının hemen görünmesi için. Açık Gezgin pencereleri kapanır."/>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- ═════════════ Disk ═════════════ -->
                <TabItem x:Name="DiskTab">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Satır 0: görünüm seçimi -->
                        <Border Style="{StaticResource SegBar}" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="FoldersModeBtn" Style="{StaticResource Seg}" Tag="Folders" Click="DiskMode_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Klasörler"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FilesModeBtn" Style="{StaticResource Seg}" Tag="Files" Click="DiskMode_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Büyük dosyalar"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TypesModeBtn" Style="{StaticResource Seg}" Tag="Types" Click="DiskMode_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Dosya türleri"/>
                                    </StackPanel>
                                </Button>
                                <Border Width="1" Background="{DynamicResource Line}" Margin="6,6"/>
                                <Button x:Name="DupModeBtn" Style="{StaticResource Seg}" Tag="Duplicates" Click="DiskMode_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Kopyalar"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="EmptyModeBtn" Style="{StaticResource Seg}" Tag="Empty" Click="DiskMode_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Boş klasörler"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RenderModeBtn" Style="{StaticResource Seg}" Tag="Renders" Click="DiskMode_Click"
                                        ToolTip="Premiere, Lightroom Classic ve DaVinci Resolve'un proje klasörlerinde bıraktığı render önizlemeleri">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE714;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Render artıkları"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Satır 1: sürücüler ya da klasör seçimi -->
                        <Grid Grid.Row="1">
                            <ItemsControl x:Name="DriveList" Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button x:Name="chip" Style="{StaticResource Btn}" Background="{DynamicResource Card}" Padding="14,9" Margin="0,0,8,6"
                                                Click="Drive_Click" ToolTip="{Binding Tooltip}" HorizontalContentAlignment="Stretch">
                                            <Grid Width="150">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="ic" Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="20"
                                                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Letter, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                                    </TextBlock>
                                                    <ProgressBar Style="{StaticResource BarStyle}" Value="{Binding UsedPercent, Mode=OneWay}" Margin="0,5,0,4"/>
                                                    <TextBlock Text="{Binding FreeText}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="chip" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource AccentText}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border x:Name="DupTop" Background="{DynamicResource Card}" CornerRadius="10" Padding="14,8" Margin="0,0,0,10" Visibility="Collapsed">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Ara" Style="{StaticResource AccentBtn}" Padding="18,6" Click="PickScan_Click" Margin="8,0,0,0"/>
                                    <Button DockPanel.Dock="Right" Content="Değiştir…" Style="{StaticResource SmallBtn}" Click="DupPickFolder_Click" Margin="8,0,0,0"/>
                                    <Button x:Name="RenderAllDrivesBtn" DockPanel.Dock="Right" Content="Tüm diskler" Style="{StaticResource SmallBtn}"
                                            Click="RenderAllDrives_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="16"
                                               Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="DupFolderText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Windows, program klasörleri, AppData ve oyun kütüphaneleri hiç taranmaz." Style="{StaticResource RowSub}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Satır 2: konum + süzgeçler ya da sonuç özeti -->
                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <StackPanel x:Name="DiskPathRow">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <TextBlock x:Name="DiskScanInfo" Style="{StaticResource Label}"/>
                                        <Button x:Name="DiskRescanBtn" Content="&#xE72C;" Style="{StaticResource IconBtn}" Click="DiskRescan_Click"
                                                Visibility="Collapsed" ToolTip="Yeniden tara"/>
                                    </StackPanel>
                                    <Button x:Name="DiskUpBtn" DockPanel.Dock="Left" Content="&#xE72B;" Style="{StaticResource IconBtn}"
                                            Click="DiskUp_Click" IsEnabled="False" Margin="0,0,6,0" ToolTip="Geri"/>
                                    <TextBlock x:Name="DiskPath" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <DockPanel x:Name="FileFilterPanel" Margin="0,8,0,0" Visibility="Collapsed">
                                    <Button x:Name="FilesDeleteBtn" DockPanel.Dock="Right" Content="Seçilenleri sil" Style="{StaticResource AccentBtn}" Padding="14,6"
                                            Margin="0" Click="FilesDelete_Click" IsEnabled="False" ToolTip="Seçilen dosyalar Geri Dönüşüm Kutusu'na taşınır"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Boyut" Style="{StaticResource Label}"/>
                                        <Border Style="{StaticResource SegBar}" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="SizeAllBtn" Content="Hepsi" Style="{StaticResource Seg}" Tag="0" Click="SizeFilter_Click"/>
                                                <Button x:Name="Size100Btn" Content="100 MB+" Style="{StaticResource Seg}" Tag="100" Click="SizeFilter_Click"/>
                                                <Button x:Name="Size1GBtn" Content="1 GB+" Style="{StaticResource Seg}" Tag="1024" Click="SizeFilter_Click"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Dokunulmamış" Style="{StaticResource Label}" ToolTip="Son değiştirilme tarihine göre"/>
                                        <Border Style="{StaticResource SegBar}">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="AgeAllBtn" Content="Hepsi" Style="{StaticResource Seg}" Tag="0" Click="AgeFilter_Click"/>
                                                <Button x:Name="Age6Btn" Content="6 ay+" Style="{StaticResource Seg}" Tag="6" Click="AgeFilter_Click"/>
                                                <Button x:Name="Age12Btn" Content="1 yıl+" Style="{StaticResource Seg}" Tag="12" Click="AgeFilter_Click"/>
                                                <Button x:Name="Age24Btn" Content="2 yıl+" Style="{StaticResource Seg}" Tag="24" Click="AgeFilter_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>

                            <DockPanel x:Name="DupInfoRow" Visibility="Collapsed">
                                <Button x:Name="DupDeleteBtn" DockPanel.Dock="Right" Content="Seçilenleri sil"
                                        Style="{StaticResource AccentBtn}" Padding="14,6" Margin="0" Click="PickDelete_Click" IsEnabled="False"/>
                                <Button x:Name="DupAutoBtn" DockPanel.Dock="Right" Content="Otomatik seç" Style="{StaticResource SmallBtn}"
                                        Click="DupAutoSelect_Click" IsEnabled="False" Margin="0,0,8,0"
                                        ToolTip="Her gruptan en eski dosya kalır, diğerleri seçilir"/>
                                <TextBlock x:Name="DupInfo" Style="{StaticResource Hint}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Grid>

                        <!-- Satır 3: liste -->
                        <Border Grid.Row="3" Style="{StaticResource ListCard}">
                            <Grid>
                                <ScrollViewer x:Name="DiskScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                    <ItemsControl x:Name="DiskList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RowBorder}" Padding="14,8" MouseLeftButtonUp="DiskRow_MouseLeftButtonUp">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="36"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,14,0"
                                                                  Visibility="{Binding IsFile, Converter={StaticResource BoolVis}}"
                                                                  IsEnabled="{Binding CanDelete}" ToolTipService.ShowOnDisabled="True"
                                                                  ToolTip="{Binding DeleteTip}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Glyph}" Style="{StaticResource RowIcon}"/>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}"/>
                                                            <TextBlock Text="{Binding Sub}" Style="{StaticResource RowSub}" ToolTip="{Binding Sub}"/>
                                                            <ProgressBar Style="{StaticResource BarStyle}" Value="{Binding Percent, Mode=OneWay}" Margin="0,6,0,1"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="14"
                                                                   VerticalAlignment="Center" MinWidth="80" TextAlignment="Right" Margin="14,0,4,0"/>
                                                        <Button Grid.Column="4" Content="&#xE838;" Style="{StaticResource IconBtn}" HorizontalAlignment="Right"
                                                                VerticalAlignment="Center" Click="DiskOpen_Click" ToolTip="{c:Tr 'Konumu aç'}"
                                                                Visibility="{Binding CanOpen, Converter={StaticResource BoolVis}}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <ScrollViewer x:Name="DupScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Visibility="Collapsed">
                                    <ItemsControl x:Name="DupList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding Header}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" Margin="6,6,0,6"/>
                                                    <ItemsControl ItemsSource="{Binding Files}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource RowBorder}" Padding="14,8" MouseLeftButtonUp="Row_MouseLeftButtonUp">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="36"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,14,0"
                                                                                  ToolTip="{c:Tr 'İşaretli olan silinir (Geri Dönüşüm Kutusuna gider)'}"/>
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}"/>
                                                                            <TextBlock Text="{Binding Details}" Style="{StaticResource RowSub}" ToolTip="{Binding FullPath}"/>
                                                                        </StackPanel>
                                                                        <Button Grid.Column="2" Content="&#xE838;" Style="{StaticResource IconBtn}" HorizontalAlignment="Right"
                                                                                VerticalAlignment="Center" Click="DupOpen_Click" ToolTip="{c:Tr 'Konumu aç'}"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <ScrollViewer x:Name="EmptyScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Visibility="Collapsed">
                                    <ItemsControl x:Name="EmptyList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RowBorder}" Padding="14,8" MouseLeftButtonUp="Row_MouseLeftButtonUp">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="36"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" ToolTip="{Binding FullPath}"/>
                                                            <TextBlock Text="{Binding Details}" Style="{StaticResource RowSub}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="&#xE838;" Style="{StaticResource IconBtn}" HorizontalAlignment="Right"
                                                                VerticalAlignment="Center" Click="EmptyOpen_Click" ToolTip="{c:Tr Aç}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <ScrollViewer x:Name="RenderScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Visibility="Collapsed">
                                    <ItemsControl x:Name="RenderList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RowBorder}" Padding="14,8" MouseLeftButtonUp="Row_MouseLeftButtonUp">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="36"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}"/>
                                                            <TextBlock Text="{Binding Details}" Style="{StaticResource RowSub}" ToolTip="{Binding FullPath}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="14"
                                                                   VerticalAlignment="Center" MinWidth="80" TextAlignment="Right" Margin="14,0,4,0"/>
                                                        <Button Grid.Column="3" Content="&#xE838;" Style="{StaticResource IconBtn}" HorizontalAlignment="Right"
                                                                VerticalAlignment="Center" Click="RenderOpen_Click" ToolTip="{c:Tr 'Konumu aç'}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <StackPanel VerticalAlignment="Center" Margin="20"
                                            Visibility="{Binding Visibility, ElementName=DiskEmpty}">
                                    <TextBlock x:Name="DiskEmptyIcon" Style="{StaticResource EmptyIcon}" Text="&#xEDA2;"/>
                                    <TextBlock x:Name="DiskEmpty" Style="{StaticResource EmptyText}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ═════════════ Araçlar ═════════════ -->
                <TabItem x:Name="ToolsTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Sol sütun -->
                                <StackPanel>
                                    <Border Style="{StaticResource ToolCard}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <Button DockPanel.Dock="Right" Content="&#xE8C8;" Style="{StaticResource IconBtn}" Click="CopySystemInfo_Click"
                                                        ToolTip="Kopyala (yardım isterken yapıştırmak için)"/>
                                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE7F8;"/>
                                                <TextBlock Text="Bu bilgisayar" Style="{StaticResource CardTitle}"/>
                                            </DockPanel>
                                            <ItemsControl x:Name="SystemInfoList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="128"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}" FontSize="12.5"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12.5"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="SystemInfoLoading" Style="{StaticResource Hint}" Text="Okunuyor…"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource ToolCard}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE708;"/>
                                                <TextBlock Text="Hazırda bekletme" Style="{StaticResource CardTitle}"
                                                           ToolTip="Kapatırsan hiberfil.sys silinir (genelde RAM'in %40-75'i kadar yer açılır) ama Hazırda Beklet ve Hızlı Başlangıç da kapanır. 'Azaltılmış' Hızlı Başlangıç'ı korur, dosyayı yaklaşık yarıya indirir."/>
                                            </DockPanel>
                                            <TextBlock x:Name="HiberText" Style="{StaticResource Hint}" FontSize="12.5" Margin="0,0,0,10"/>
                                            <Border Style="{StaticResource SegBar}" Background="{DynamicResource Row}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="HiberOffBtn" Content="Kapalı" Style="{StaticResource Seg}" Tag="off" Click="Hibernate_Click"
                                                            ToolTip="hiberfil.sys silinir; Hazırda Beklet ve Hızlı Başlangıç kapanır"/>
                                                    <Button x:Name="HiberReducedBtn" Content="Azaltılmış" Style="{StaticResource Seg}" Tag="reduced" Click="Hibernate_Click"
                                                            ToolTip="Hızlı Başlangıç çalışır, dosya yaklaşık yarıya iner"/>
                                                    <Button x:Name="HiberFullBtn" Content="Tam" Style="{StaticResource Seg}" Tag="full" Click="Hibernate_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource ToolCard}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <Button DockPanel.Dock="Right" Content="&#xE72C;" Style="{StaticResource IconBtn}" Click="WuCheck_Click" ToolTip="Kontrol et"/>
                                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE895;"/>
                                                <TextBlock Text="Windows Update" Style="{StaticResource CardTitle}"/>
                                            </DockPanel>
                                            <TextBlock x:Name="WuText" Style="{StaticResource Hint}" FontSize="12.5" Text="Kontrol ediliyor…"/>
                                            <ItemsControl x:Name="WuList" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,2"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button x:Name="WuPauseBtn" Content="1 hafta ertele" Style="{StaticResource SmallBtn}" Click="WuPause_Click"
                                                        c:Elevation.Required="True" ToolTip="Ayarlar'daki 'Güncellemeleri duraklat' ile aynı. Süre bitince güncellemeler kendiliğinden sürer."/>
                                                <Button Content="Ayarlar'da aç" Style="{StaticResource SmallBtn}" Click="WuOpen_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource ToolCard}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE945;"/>
                                                <TextBlock Text="Güç ve performans" Style="{StaticResource CardTitle}"/>
                                            </DockPanel>
