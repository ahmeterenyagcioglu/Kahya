                                            <DataTemplate>
                                                <StackPanel Margin="0,4,0,10">
                                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"/>
                                                    <TextBlock Text="{Binding Notes}" Style="{StaticResource Hint}" FontSize="12.5" Margin="0,4,0,0" LineHeight="20"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- İşlem kaydı çekmecesi -->
            <Border x:Name="LogPanel" Grid.Row="3" Background="{DynamicResource Card}" CornerRadius="10"
                    Padding="14,10" Margin="0,12,0,0" Height="200" Visibility="Collapsed">
                <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" BorderThickness="0"
                         Background="Transparent" Foreground="{DynamicResource LogText}"
                         FontFamily="Cascadia Mono, Consolas" FontSize="11.5"/>
            </Border>

            <!-- Durum çubuğu -->
            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar x:Name="Progress" Height="2" Visibility="Hidden"
                             Background="Transparent" Foreground="{DynamicResource Accent}" BorderThickness="0"/>
                <DockPanel Grid.Row="1" Margin="0,6,0,10">
                    <Button x:Name="LogToggleBtn" DockPanel.Dock="Right" Content="İşlem kaydı ▴" Style="{StaticResource GhostBtn}" Click="LogToggle_Click"/>
                    <Button x:Name="CancelBtn" DockPanel.Dock="Right" Content="İptal" Style="{StaticResource SmallBtn}" Margin="0,0,6,0"
                            Click="Cancel_Click" Visibility="Collapsed"/>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="12"
                               TextTrimming="CharacterEllipsis" Text="Hazır"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
