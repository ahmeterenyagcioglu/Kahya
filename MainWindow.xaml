                                                <TextBlock Text="Pil sağlığı" Style="{StaticResource CardTitle}"
                                                           ToolTip="Pilin şu anki tam şarj kapasitesinin, yeniyken sahip olduğu kapasiteye oranı. %80'in altı belirgin yıpranma demektir."/>
                                            </DockPanel>
                                            <ItemsControl x:Name="BatteryList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource StaticRow}">
