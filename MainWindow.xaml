                                                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
