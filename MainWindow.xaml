                                                    <TextBlock Text="Birkaç saniye kopar" Style="{StaticResource RowSub}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource ActionRow}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Çalıştır" Style="{StaticResource SmallBtn}" Margin="10,0,0,0" Tag="reset" c:Elevation.Required="True" Click="Network_Click" VerticalAlignment="Center"/>
                                                <StackPanel ToolTip="netsh winsock reset + int ip reset — bozulmuş ağ yığınını varsayılana döndürür. Yeniden başlatma gerekir; elle girilmiş sabit IP ayarları silinir.">
                                                    <TextBlock Text="Ağı sıfırla" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="Yeniden başlatma ister" Style="{StaticResource RowSub}"/>
