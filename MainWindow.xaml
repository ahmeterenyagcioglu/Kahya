                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Çalıştır" Style="{StaticResource SmallBtn}" Margin="10,0,0,0" Tag="optimize" c:Elevation.Required="True" Click="Repair_Click" VerticalAlignment="Center"/>
