<Window x:Class="Kahya.HostsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="hosts dosyası" Width="760" Height="560" MinWidth="520" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Card}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="hosts dosyası" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Her satır bir adı bir adrese yönlendirir: '0.0.0.0 reklam.com' o siteyi engeller. # ile başlayan satırlar açıklamadır. Kaydetmeden önce eski hali yedeklenir."/>
            <TextBlock x:Name="WarningText" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Bg}" CornerRadius="10" Padding="12,10">
            <TextBox x:Name="Editor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0" Background="Transparent" Foreground="{DynamicResource LogText}" CaretBrush="{DynamicResource Text}"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12.5" TextChanged="Editor_TextChanged"/>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="İptal" Style="{StaticResource Btn}" IsCancel="True"/>
                <Button x:Name="SaveBtn" Content="Kaydet" Style="{StaticResource AccentBtn}" Margin="0" Click="Save_Click"/>
            </StackPanel>
            <Button Content="Windows varsayılanı" Style="{StaticResource Btn}" Click="Default_Click"
                    ToolTip="Kurulumla gelen boş hosts dosyası (yalnızca açıklamalar). Kaydedince uygulanır."/>
            <TextBlock x:Name="CountText" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </DockPanel>
    </Grid>
</Window>
