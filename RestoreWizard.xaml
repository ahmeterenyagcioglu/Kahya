<Window x:Class="Kahya.RestoreWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Format sonrası asistanı" Width="920" Height="680" MinWidth="780" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="WizRow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="RowSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="RowIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="DockPanel.Dock" Value="Left"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PageSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,18"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Margin" Value="2,14,0,8"/>
        </Style>

        <!-- Bir kategorinin içindeki öğe: tek sütun, ad solda, boyut/not sağda -->
        <DataTemplate x:Key="ItemRow">
            <DockPanel Margin="0,1" Background="Transparent">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}" Click="Item_Click"
                          VerticalAlignment="Center" Padding="8,3,0,3">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                </CheckBox>
            </DockPanel>
        </DataTemplate>

        <!-- Bir kategori kartı: anahtar, "Seç" ile açılan sınırlı yükseklikli liste, uzunsa arama -->
        <DataTemplate x:Key="CategoryCard">
            <Border Style="{StaticResource WizRow}">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding IsChecked, Mode=OneWay}"
                                  IsEnabled="{Binding IsEnabled}" VerticalAlignment="Center" Click="Category_Click"/>
                        <Button DockPanel.Dock="Right" Content="{Binding ExpandText}" Style="{StaticResource GhostBtn}"
                                Margin="0,0,10,0" VerticalAlignment="Center" Click="Expand_Click"/>
                        <TextBlock Style="{StaticResource RowIcon}" Text="{Binding Icon}"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource RowSub}"/>
                        </StackPanel>
                    </DockPanel>
                    <!-- Uzun listeler sayfayı kaplamasın: sınırlı yükseklik, kendi içinde kaydırma; 10'dan uzunsa arama -->
                    <StackPanel Margin="34,10,0,0" Visibility="{Binding Expanded, Converter={StaticResource BoolVis}}">
                        <DockPanel Margin="0,0,0,6" Visibility="{Binding HasTools, Converter={StaticResource BoolVis}}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Tümü" Style="{StaticResource SmallBtn}" Click="CategoryAll_Click"/>
                                <Button Content="Hiçbiri" Style="{StaticResource SmallBtn}" Margin="0" Click="CategoryNone_Click"/>
                            </StackPanel>
                            <Grid Width="220" HorizontalAlignment="Left">
                                <TextBox Style="{StaticResource SearchBox}" Height="32" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Muted}"
                                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0"/>
                                <TextBlock Text="Ara…" Foreground="{DynamicResource Faint}" IsHitTestVisible="False" VerticalAlignment="Center"
                                           Margin="33,0,0,0" Visibility="{Binding SearchEmpty, Converter={StaticResource BoolVis}}"/>
                            </Grid>
                        </DockPanel>
                        <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding View}" ItemTemplate="{StaticResource ItemRow}"/>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ───── adımlar ───── -->
        <Border Background="{DynamicResource Side}" Padding="22,26,16,20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,26">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentGradient}" Margin="0,0,10,0">
                        <TextBlock Text="&#xE777;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Format sonrası" FontWeight="SemiBold"/>
                        <TextBlock Text="asistanı" Foreground="{DynamicResource Muted}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" x:Name="AdminNote" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                <ItemsControl x:Name="StepList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,14">
                                <Border Width="26" Height="26" CornerRadius="13" Background="{Binding Badge}" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Mark}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding MarkColor}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="{Binding Weight}" Foreground="{Binding TitleColor}"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource Faint}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" Margin="30,26,30,20">
            <!-- ───── alt düğmeler ───── -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" LastChildFill="False">
                <Button x:Name="NextBtn" DockPanel.Dock="Right" Content="İleri" Style="{StaticResource AccentBtn}" Margin="0" IsDefault="True" Click="Next_Click"/>
                <Button x:Name="BackBtn" DockPanel.Dock="Right" Content="Geri" Style="{StaticResource Btn}" Click="Back_Click"/>
                <Button x:Name="CancelBtn" DockPanel.Dock="Left" Content="Kapat" Style="{StaticResource GhostBtn}" Click="Cancel_Click"/>
            </DockPanel>

            <Grid>
                <!-- ═════ 1. Yedek ═════ -->
                <DockPanel x:Name="PageBackup">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Yedeği seç" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource PageSub}"
                                   Text="Format öncesi Kahya ile aldığın yedek (Kahya-Yedek-….kahya). USB bellek ya da ikinci disk takılıysa Kahya kendisi bulur."/>
                        <Border x:Name="InstalledBanner" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed">
                            <DockPanel>
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{DynamicResource Good}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock x:Name="InstalledText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Border x:Name="ResumeBanner" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Kaldığın yerden devam et" Style="{StaticResource AccentBtn}" Margin="10,0,0,0"
                                        VerticalAlignment="Center" Click="Resume_Click"/>
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{DynamicResource AccentText}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock x:Name="ResumeText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Border x:Name="AdminBanner" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Yönetici olarak yeniden başlat" Style="{StaticResource SmallBtn}" Margin="10,0,0,0"
                                        VerticalAlignment="Center" Click="RestartAdmin_Click"/>
                                <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{DynamicResource AccentText}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="Sürücüleri kurabilmek için Kahya'nın yönetici olarak çalışması gerekiyor. Yeniden başlayınca asistan kaldığı yerden açılır."/>
                            </DockPanel>
                        </Border>
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="BrowseBtn" DockPanel.Dock="Right" Content="Manuel olarak seç" Style="{StaticResource SmallBtn}" Margin="0" Click="Browse_Click"/>
                            <TextBlock x:Name="FoundText" Text="Yedekler aranıyor…" Style="{StaticResource Section}" Margin="2,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                    <TextBlock x:Name="BackupInfo" DockPanel.Dock="Bottom" Style="{StaticResource RowSub}" Margin="2,10,0,0"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="FoundList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="b" Style="{StaticResource WizRow}" Cursor="Hand" MouseLeftButtonUp="Found_Click" BorderThickness="2" BorderBrush="Transparent">
                                        <DockPanel>
                                            <TextBlock Style="{StaticResource RowIcon}" Text="{Binding Icon}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource RowSub}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Selected}" Value="True">
                                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- ═════ 2. İnternet ═════ -->
                <DockPanel x:Name="PageNet" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="İnternet ve Wi-Fi" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource PageSub}"
                                   Text="Programları kurmak ve ekran kartı sürücüsüne bakmak için internet gerekiyor. Wi-Fi ağlarını buradan şifreleriyle ekleyebilirsin; internet yoksa önce ağ kartının sürücüsünü kuralım."/>
                        <Border Style="{StaticResource WizRow}">
                            <DockPanel>
                                <Button x:Name="NetRetryBtn" DockPanel.Dock="Right" Content="Tekrar dene" Style="{StaticResource SmallBtn}" Margin="10,0,0,0"
                                        VerticalAlignment="Center" Click="NetRetry_Click"/>
                                <TextBlock x:Name="NetIcon" Style="{StaticResource RowIcon}" Text="&#xE701;"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="NetTitle" Text="Kontrol ediliyor…" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="NetSub" Style="{StaticResource RowSub}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border x:Name="NetDriverCard" Style="{StaticResource WizRow}" Visibility="Collapsed">
                            <DockPanel>
                                <Button x:Name="NetDriverBtn" DockPanel.Dock="Right" Content="Sürücüyü kur" Style="{StaticResource AccentBtn}" Margin="10,0,0,0"
                                        VerticalAlignment="Center" Click="NetDriver_Click"/>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE839;"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Ağ kartı sürücüsü" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="NetDriverSub" Style="{StaticResource RowSub}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                    <Border x:Name="WifiCard" Style="{StaticResource WizRow}" Margin="0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button x:Name="WifiAddBtn" DockPanel.Dock="Right" Content="Seçilenleri ekle" Style="{StaticResource SmallBtn}" Margin="10,0,0,0"
                                        VerticalAlignment="Center" Click="WifiAdd_Click"/>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE701;"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Kayıtlı Wi-Fi ağları" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="WifiSub" Style="{StaticResource RowSub}"/>
                                </StackPanel>
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="34,0,0,0">
                                <ItemsControl x:Name="WifiList" ItemTemplate="{StaticResource ItemRow}"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DockPanel>

                <!-- ═════ 3. Programlar ═════ -->
                <DockPanel x:Name="PagePrograms" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Programlar" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource PageSub}"
                                   Text="Kurulacak programları seç; hepsinin en yeni sürümü winget ile kurulur. Kurulum ilk sırada yapılır, ayarlar ve oyun kayıtları onlardan sonra gelir."/>
                    </StackPanel>
                    <!-- Sayfa kendi içinde kayar: bileşen listesi açılınca program listesi sıkışıp kaybolmasın -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <!-- Visual C++, DirectX, .NET: programlardan önce kurulur -->
                            <ItemsControl x:Name="EssentialsList" ItemTemplate="{StaticResource CategoryCard}" Margin="0,0,0,6"/>
                            <DockPanel Margin="0,4,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Tümü" Style="{StaticResource SmallBtn}" Click="ProgramsAll_Click"/>
                                    <Button Content="Hiçbiri" Style="{StaticResource SmallBtn}" Margin="0" Click="ProgramsNone_Click"/>
                                </StackPanel>
                                <Grid Width="260" HorizontalAlignment="Left">
                                    <TextBox x:Name="ProgramSearch" Style="{StaticResource SearchBox}" Height="34" TextChanged="ProgramSearch_TextChanged"/>
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Muted}"
                                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0"/>
                                    <TextBlock x:Name="ProgramSearchHint" Text="Ara…" Foreground="{DynamicResource Faint}" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="33,0,0,0"/>
                                </Grid>
                            </DockPanel>
                            <Border Style="{StaticResource WizRow}" Margin="0" Padding="16,10">
                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ProgramList" ItemTemplate="{StaticResource ItemRow}"/>
                                </ScrollViewer>
                            </Border>
                            <TextBlock x:Name="ProgramsInfo" Style="{StaticResource RowSub}" Margin="2,6,0,0"/>
                            <Border x:Name="ManualCard" Style="{StaticResource WizRow}" Margin="0,8,0,0">
                                <DockPanel>
                                    <Button x:Name="ManualSaveBtn" DockPanel.Dock="Right" Content="Listeyi masaüstüne kaydet" Style="{StaticResource SmallBtn}" Margin="10,0,0,0"
                                            VerticalAlignment="Center" Click="ManualSave_Click"/>
                                    <TextBlock Style="{StaticResource RowIcon}" Text="&#xE7C3;"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="ManualTitle" Style="{StaticResource RowTitle}"/>
                                        <TextBlock x:Name="ManualSub" Style="{StaticResource RowSub}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- ═════ 4. Dosyalar ve kayıtlar ═════ -->
                <DockPanel x:Name="PageChoose" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Dosyalar ve kayıtlar" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource PageSub}"
                                   Text="Her kategoriyi açıp içindekileri tek tek seçebilirsin. Programlardan sonra yüklenir; oyun kayıtları en sonda. Var olan dosyaların daha yenisi varsa üzerine yazılmaz."/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <ItemsControl x:Name="CategoryList" ItemTemplate="{StaticResource CategoryCard}"/>
                    </ScrollViewer>
                </DockPanel>

                <!-- ═════ 4. Ekran kartı ═════ -->
                <StackPanel x:Name="PageGpu" Visibility="Collapsed">
                    <TextBlock Text="Ekran kartı sürücüsü" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource PageSub}"
                               Text="Format sonrası Windows çoğu zaman genel bir sürücü kurar; oyunlar ve video programları için üreticinin sürücüsü gerekir."/>
                    <ItemsControl x:Name="GpuList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource WizRow}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{Binding ButtonText}" Style="{StaticResource SmallBtn}" Margin="10,0,0,0"
                                                VerticalAlignment="Center" Click="GpuPage_Click" Visibility="{Binding LinkVisibility}"/>
                                        <TextBlock Style="{StaticResource RowIcon}" Text="{Binding Icon}" Foreground="{Binding IconColor}"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource RowSub}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="GpuNote" Style="{StaticResource RowSub}" Margin="2,6,0,0" Text="Kontrol ediliyor…"/>
                </StackPanel>

                <!-- ═════ 5. Geri yükleme ═════ -->
                <DockPanel x:Name="PageRun" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="RunTitle" Text="Geri yükleniyor" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Name="RunSub" Style="{StaticResource PageSub}" Text="Bilgisayarı kullanmaya devam edebilirsin. Kapatırsan sonra kaldığı yerden devam eder."/>
                        <ProgressBar x:Name="RunProgress" Height="4" IsIndeterminate="True" Margin="0,0,0,8"
                                     Background="{DynamicResource Row}" Foreground="{DynamicResource Accent}" BorderThickness="0"/>
                        <TextBlock x:Name="RunStatus" Style="{StaticResource RowSub}" Margin="0,0,0,10"/>
                        <WrapPanel x:Name="DoneButtons" Visibility="Collapsed" Margin="0,0,0,10">
                            <Button x:Name="BookmarksBtn" Content="Yer imleri klasörünü aç" Style="{StaticResource SmallBtn}" Click="Bookmarks_Click"/>
                            <Button x:Name="RebootBtn" Content="Yeniden başlat" Style="{StaticResource SmallBtn}" Click="Reboot_Click"/>
                        </WrapPanel>
                    </StackPanel>
                    <Border Background="{DynamicResource Card}" CornerRadius="10" Padding="12,10">
                        <TextBox x:Name="RunLog" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Text}"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
