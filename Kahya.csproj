<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Kahya</AssemblyName>
    <RootNamespace>Kahya</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Sadece yayınlarken yükselt: düzeltme 1.0.x, yeni özellik 1.x.0. Notlar: Core/AppInfo.cs -->
    <Version>1.7.0</Version>
    <Product>Kahya</Product>
    <Authors>Ahmet Eren Yağcıoğlu</Authors>
    <Company>Ahmet Eren Yağcıoğlu</Company>
    <Copyright>© 2026 Ahmet Eren Yağcıoğlu</Copyright>
    <Description>Windows temizlik, güncelleme ve bakım aracı</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <!-- .kahya yedek dosyalarının simgesi; ilk açılışta Data klasörüne çıkarılıp dosya ilişkilendirmesine verilir. -->
    <EmbeddedResource Include="kahya-file.ico" LogicalName="kahya-file.ico" />
    <!-- Dil dosyaları (lang/en.xml, lang/de.xml…): exe'ye gömülür; Data\Lang'a konanlar da okunur. -->
    <EmbeddedResource Include="lang\*.xml" LogicalName="lang.%(Filename).xml" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Management" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Microsoft.VisualBasic" />  </ItemGroup>

</Project>
